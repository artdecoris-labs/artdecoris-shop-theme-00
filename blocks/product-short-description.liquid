{%- doc -%}
  The short text under a product's title, in the shopper's language. Art
  Decoris addition, not part of stock Horizon.

  Reads the product metafield custom.short_description: JSON with one text
  per locale ({"nl": "…", "fr": "…", "en": "…"}), as the migration from Odoo
  writes it (description_sale in each language). The shopper's locale first,
  then the store's primary one, then whichever is there.
{%- enddoc -%}

{%- liquid
  assign texts = closest.product.metafields.custom.short_description.value
  assign lang = request.locale.iso_code | split: '-' | first
  assign primary = shop.locale | split: '-' | first
  assign text = texts[request.locale.iso_code] | default: texts[lang] | default: texts[primary]
  if text == blank and texts != blank
    for pair in texts
      assign text = pair[1]
      break
    endfor
  endif
-%}

{%- if text != blank -%}
  <p
    class="product-short-description spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {{ text | escape | newline_to_br }}
  </p>
{%- endif -%}

{% stylesheet %}
  .product-short-description {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80, 0.8));
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product short text",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's short text (custom.short_description) in the shopper's language."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product short text"
    }
  ]
}
{% endschema %}
