{%- doc -%}
  A product's specifications as a table, grouped as Odoo's Specifications tab
  shows them, in the shopper's language. Art Decoris addition, not part of
  stock Horizon.

  Reads the product metafield custom.specifications, as the migration from
  Odoo writes it:
    [{"group": {"nl": "Kussen", "fr": "Coussin", …},
      "rows": [{"name": {"nl": "Maat", …}, "values": [{"nl": "45 x 45 cm", …}]}]}]
  Each text in the shopper's locale, else the store's primary one, else
  whichever is there.
{%- enddoc -%}

{%- liquid
  assign specs = closest.product.metafields.custom.specifications.value
  assign full = request.locale.iso_code
  assign lang = full | split: '-' | first
  assign primary = shop.locale | split: '-' | first
-%}

{%- if specs != blank -%}
  <div
    class="product-specifications spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- for group in specs -%}
      {%- liquid
        assign group_name = group.group[full] | default: group.group[lang] | default: group.group[primary]
        if group_name == blank
          for pair in group.group
            assign group_name = pair[1]
            break
          endfor
        endif
      -%}
      <table class="product-specifications__table">
        {%- if block.settings.show_groups and group_name != blank -%}
          <caption class="product-specifications__group">{{ group_name | escape }}</caption>
        {%- endif -%}
        <tbody>
          {%- for row in group.rows -%}
            {%- liquid
              assign row_name = row.name[full] | default: row.name[lang] | default: row.name[primary]
              if row_name == blank
                for pair in row.name
                  assign row_name = pair[1]
                  break
                endfor
              endif
            -%}
            <tr>
              <th scope="row">{{ row_name | escape }}</th>
              <td>
                {%- for value in row.values -%}
                  {%- liquid
                    assign v = value[full] | default: value[lang] | default: value[primary]
                    if v == blank
                      for pair in value
                        assign v = pair[1]
                        break
                      endfor
                    endif
                  -%}
                  {{- v | escape -}}
                  {%- unless forloop.last %}, {% endunless -%}
                {%- endfor -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endfor -%}
  </div>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>This product has no specifications (custom.specifications).</p>
{%- endif -%}

{% stylesheet %}
  .product-specifications {
    display: grid;
    gap: 1.25rem;
  }

  .product-specifications__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size--sm, 0.875rem);
  }

  .product-specifications__group {
    text-align: start;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-block-end: 0.5rem;
  }

  .product-specifications__table th,
  .product-specifications__table td {
    text-align: start;
    vertical-align: top;
    padding: 0.5rem 0;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  .product-specifications__table th {
    width: 40%;
    font-weight: 500;
    padding-inline-end: 1rem;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product specifications",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's specifications (custom.specifications) as a table, in the shopper's language."
    },
    {
      "type": "checkbox",
      "id": "show_groups",
      "label": "Show group names",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product specifications"
    }
  ]
}
{% endschema %}
